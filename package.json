{
  "name": "track-lab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "yarn@4.9.2",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "yarn workspace @track-lab/api start",
    "dev:docker": "docker compose --env-file .env -f docker/docker-compose.yml up --build",
    "dev:web": "yarn workspace @track-lab/web dev",
    "prisma:generate": "prisma generate --config prisma.config.ts",
    "prisma:migrate:dev": "prisma migrate dev --config prisma.config.ts",
    "prisma:migrate:deploy": "prisma migrate deploy --config prisma.config.ts",
    "postinstall": "node scripts/generate-prisma-client.mjs",
    "start": "yarn workspace @track-lab/api start",
    "affected": "nx affected",
    "affected:check": "nx affected -t test,typecheck",
    "test": "yarn workspaces foreach --all run test",
    "typecheck": "yarn workspaces foreach --all --topological-dev run typecheck"
  },
  "devDependencies": {
    "nx": "^22.7.1",
    "prisma": "^7.8.0"
  },
  "dependencies": {
    "@aws-sdk/client-sqs": "^3.1048.0"
  }
}
