FROM node:22-alpine

WORKDIR /app

# TODO(production): split into build/runtime stages and copy compiled dist output.
RUN corepack enable

COPY package.json yarn.lock .yarnrc.yml ./
COPY apps ./apps
COPY packages ./packages
COPY scripts ./scripts
COPY prisma.config.ts ./
COPY nx.json ./

RUN yarn install --immutable

CMD ["yarn", "workspace", "@track-lab/worker", "start:docker"]
